<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup Label="Build">
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Label="Package identity">
        <PackageId>Umb.ElementFinder</PackageId>
        <Version>17.2.0</Version>
        <Title>Element Finder</Title>
        <Authors>Giriraj Digital</Authors>
        <Description>Find and track where Umbraco Element Types are used across your content pages, with a clear dashboard view of their usage and references.</Description>
        <PackageTags>umbraco-marketplace;umbraco;element-types;backoffice;developer-tools;element-finder</PackageTags>
        <PackageReleaseNotes>
Removes the custom database tables. No migration is required, and the startup crash in 17.0.0 is gone for good.

- Element Type usage is now held in memory and built on first use, so a site where nobody opens the dashboard does no work at all.
- Removed the umbElementFinderUsage and umbElementFinderState tables and the package migration that created them. Installing no longer depends on unattended package migrations being enabled.
- Fixed: sites no longer fail to start with "Invalid object name 'umbElementFinderState'".
- Usage counts now refresh correctly after content is trashed, restored, moved, or deleted.
- Upgrading from 17.0.x: the two old tables are left in place and can safely be dropped by hand.
        </PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Label="Listing metadata">
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright © 2026 Giriraj Digital</Copyright>
        <PackageProjectUrl>https://github.com/Nikhilgirirajdigital/umb.elementfinder</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Nikhilgirirajdigital/umb.elementfinder</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <PropertyGroup Label="Packing">
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <!-- Serves the backoffice bundle from /App_Plugins/ElementFinder, which is where
             umbraco-package.json points, rather than the default /_content/Umb.ElementFinder. -->
        <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    </PropertyGroup>

    <ItemGroup Label="Shipped in the package root">
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup Label="Dev-time files that must not ship">
        <!-- The SDK globs these in as Content, and NuGet would then copy them into every
             consuming project. None of them belong in the shipped package; the backoffice
             assets under wwwroot are packed as static web assets and are unaffected. -->
        <Content Update="Client\**" Pack="false" />
        <Content Update="appsettings-schema.json" Pack="false" />
        <Content Update="appsettings-schema.Umbraco.Cms.json" Pack="false" />
        <Content Update="umbraco-package-schema.json" Pack="false" />
        <Content Update="umbraco-marketplace.json" Pack="false" />
    </ItemGroup>

    <ItemGroup Label="The test project sits inside this project's directory">
        <Compile Remove="Tests\**" />
        <Content Remove="Tests\**" />
        <EmbeddedResource Remove="Tests\**" />
        <None Remove="Tests\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Umbraco.Cms" Version="[17.0.0,19.0.0)" />
    </ItemGroup>

</Project>
